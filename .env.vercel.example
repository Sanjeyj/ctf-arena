# =============================================================================
# CTF Arena v1.0.0 — Vercel Environment Variables
# EthicBids Technologies™
# =============================================================================
# Add these variables inside your Vercel Project Settings -> Environment Variables.
# =============================================================================

# Flask Environment configuration
FLASK_ENV=production

# Cryptographic secret key for session signatures (Minimum 64 random hex chars)
SECRET_KEY=

# Seeded Admin Credentials (to be customized on database initialize)
ADMIN_USER=admin
ADMIN_PASSWORD=

# Production database URL pointing to an external PostgreSQL instance (with SSL)
DATABASE_URL=postgresql://ctfarena:PASSWORD@YOUR_POSTGRES_HOST:5432/ctfarena?sslmode=require

# External Redis instance URL for rate-limiting sync
REDIS_URL=redis://:PASSWORD@YOUR_REDIS_HOST:6379/0

# Session cookie configurations (must be True for HTTPS Vercel domains)
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# Number of trusted proxy hops (Vercel routes requests through standard proxies)
TRUSTED_PROXIES=1

# Application logs configuration
LOG_LEVEL=warning
METRICS_ENABLED=False
