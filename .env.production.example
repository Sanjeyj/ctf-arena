# =============================================================================
# CTF Arena v1.0.0 — Production Environment Variables
# EthicBids Technologies™
# =============================================================================
# Copy this file to .env.production and fill in all required values.
# NEVER commit .env.production to version control.
# =============================================================================

# ── Application ───────────────────────────────────────────────────────────────

# REQUIRED — Flask secret key. Generate with: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=

# REQUIRED — Admin username (default: admin)
ADMIN_USER=admin

# REQUIRED — Admin password. Must be changed from default.
ADMIN_PASSWORD=

# Flask environment. Must be 'production'.
FLASK_ENV=production

# Application version tag for Docker image
APP_VERSION=1.0.0

# ── Database (PostgreSQL) ──────────────────────────────────────────────────────

# REQUIRED — Full PostgreSQL connection URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://ctfarena:CHANGE_ME@db:5432/ctfarena

# Individual Postgres components (used by docker-compose.production.yml)
POSTGRES_DB=ctfarena
POSTGRES_USER=ctfarena
POSTGRES_PASSWORD=

# ── Redis ────────────────────────────────────────────────────────────────────

# REQUIRED — Full Redis connection URL
# Format: redis://:PASSWORD@HOST:PORT/DB
REDIS_URL=redis://:CHANGE_ME@redis:6379/0

# Redis password (used by docker-compose.production.yml)
REDIS_PASSWORD=

# ── Network / Proxy ───────────────────────────────────────────────────────────

# Number of trusted proxy hops (set to 1 for single Nginx proxy)
TRUSTED_PROXIES=1

# HTTP/HTTPS listen ports
HTTP_PORT=80
HTTPS_PORT=443

# ── Session & Cookies ─────────────────────────────────────────────────────────

# Enforce secure cookies (HTTPS only). Must be True in production.
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# ── File Uploads ──────────────────────────────────────────────────────────────

# Maximum upload size in bytes (default: 16 MB)
MAX_CONTENT_LENGTH=16777216

# ── Rate Limiting ─────────────────────────────────────────────────────────────

RATE_LIMIT_LOGIN=5 per minute
RATE_LIMIT_SUBMIT=10 per minute
RATE_LIMIT_API=60 per minute

# ── Gunicorn ──────────────────────────────────────────────────────────────────

# Number of worker processes (recommended: 2 * CPU cores + 1)
GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=30
GUNICORN_BIND=0.0.0.0:8000
GUNICORN_WORKER_CLASS=sync
GUNICORN_LOG_LEVEL=warning

# ── Logging ───────────────────────────────────────────────────────────────────

# Log level: debug, info, warning, error, critical
LOG_LEVEL=warning

# ── Metrics ───────────────────────────────────────────────────────────────────

METRICS_ENABLED=True

# ── Monitoring (Grafana) ──────────────────────────────────────────────────────

GRAFANA_ADMIN_USER=admin
GRAFANA_PASSWORD=
GRAFANA_ROOT_URL=https://your-domain.com/grafana

# ── Email / SMTP (Optional) ───────────────────────────────────────────────────

MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=no-reply@your-domain.com

# ── SSL / TLS ─────────────────────────────────────────────────────────────────

# Paths to TLS certificate and key (relative to deployment/certs/)
# Managed by Certbot or Caddy automatically.
SSL_CERT_PATH=deployment/certs/fullchain.pem
SSL_KEY_PATH=deployment/certs/privkey.pem

# ── Domain ────────────────────────────────────────────────────────────────────

DOMAIN=your-domain.com
