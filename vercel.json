{
  "framework": null,
  "functions": {
    "api/index.py": {
      "excludeFiles": [
        ".node/**",
        ".node.zip",
        ".venv/**",
        "venv/**",
        "_uv/**",
        "logs/**",
        "tests/**",
        "docs/**",
        "portfolio/**",
        "governance/**",
        "legal/**",
        "marketing/**",
        "sales/**",
        "partners/**",
        "finance/**",
        "investor/**",
        "community/**",
        "strategy/**",
        "research/**",
        "instance/*.zip"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
