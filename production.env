# =====================================================================
# CTF Arena v2 — Production Configuration
# =====================================================================

# --- Core Flask Settings ---
FLASK_APP=run.py
FLASK_ENV=production
FLASK_DEBUG=0

# Secret key used for session signing. MUST be a strong, random 32+ char value.
# Generate via: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=92b75bc9894c4b998ef9f1197f6af56a31c5ea93333333333333333333333333

# --- Database & Caching ---
# PostgreSQL Connection URL (replaced SQLite)
DATABASE_URL=postgresql://ctf_prod_user:SecureDBPassword123!@db.example.com:5432/ctf_production_db

# Redis connection URL for rate limiting tracking (Highly recommended in production)
REDIS_URL=redis://redis.example.com:6379/0

# --- Admin Credentials ---
# Default admin user credentials. Overridden on seed/init commands.
ADMIN_USER=admin
ADMIN_PASSWORD=ctf_admin_2024

# --- Session & Security Cookie Hardening ---
# Enforce secure cookies (must be set to True behind HTTPS)
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
PREFERRED_URL_SCHEME=https

# Number of trusted reverse-proxy headers hops (e.g. 1 if behind single Nginx reverse proxy)
TRUSTED_PROXIES=1

# Comma-separated list of allowed hostnames
ALLOWED_HOSTS=ctf.example.com,www.ctf.example.com

# --- Rate Limiting (OWASP Protections) ---
RATE_LIMIT_LOGIN=5 per minute
RATE_LIMIT_SUBMIT=10 per minute
RATE_LIMIT_API=60 per minute
RATE_LIMIT_GLOBAL=100 per minute
MAX_LOGIN_ATTEMPTS=5

# --- Upload Limits ---
# Max upload size in bytes (16777216 = 16MB)
MAX_CONTENT_LENGTH=16777216

# --- Docker Challenge Resource Limits ---
DOCKER_CPU_LIMIT=0.5
DOCKER_MEM_LIMIT=128m
DOCKER_INSTANCE_TTL_MINUTES=30
DOCKER_MAX_CONTAINERS_PER_USER=1
DOCKER_PRUNE_INTERVAL_MINUTES=5
